# === LLM Provider ===
# "openai", "ollama", or "alibaba"
LLM_PROVIDER=alibaba

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (local dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Alibaba Cloud (DashScope - Qwen)
ALIBABA_API_KEY=sk-xxx
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus
ALIBABA_EMBEDDING_MODEL=text-embedding-v3

# === Database (read-only, shared with NestJS) ===
DATABASE_URL=postgresql+asyncpg://travelmind:secret@localhost:5432/travelmind

# === RabbitMQ ===
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# === Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_HOTELS=hotels
QDRANT_COLLECTION_REVIEWS=reviews
QDRANT_COLLECTION_BOOKINGS=bookings

# === App ===
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# === Embedding ===
EMBEDDING_DIMENSION=1536

# === Scraping (Demo Mode) ===
SCRAPING_MAX_REQUESTS_PER_DAY=2
SCRAPING_ENABLED=true

# === LangSmith ===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxx
LANGCHAIN_PROJECT=travelmind-ai